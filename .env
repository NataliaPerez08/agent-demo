OPENAI_API_KEY=TU_API_KEY

# Modelo: analyst-local-fast usa Ollama (qwen2.5:1.5b), sin API key.
# Cambiar a analyst-smart para OpenAI (requiere clave real).
ANALYST_MODEL=analyst-local-fast

LITELLM_MASTER_KEY=sk-local-secret
LITELLM_BASE_URL=http://litellm:4000/v1

LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm
LITELLM_REDIS_URL=redis://litellm-redis:6379/0

AGENT_DATABASE_URL=postgresql://agent:agent@app-postgres:5432/agent
ANALYTICS_DATABASE_URL=postgresql://analyst_agent:analyst@app-analytics:5432/analytics

REDIS_URL=redis://app-redis:6379/0
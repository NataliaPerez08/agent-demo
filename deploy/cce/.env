# .env para deploy en Huawei Cloud CCE
# Copiar a .env y rellenar con valores reales antes de:
#   make deploy-cce   (o)   make image

# ---- Huawei Cloud MaaS (ModelArts) ----
# API Key de MaaS: https://console.huaweicloud.com/modelarts/
MAAS_API_KEY=

# ---- SWR (SoftWare Repository) ----
# Region de Huawei Cloud (ej: cn-north-4, cn-east-3, sa-brazil-1)
SWR_REGION=cn-north-4

# Organizacion (namespace) dentro de SWR
SWR_ORG=mi-org

# Tag de la imagen
IMAGE_TAG=latest

# Token de login de SWR (generar en consola IAM > Login Credentials)
# No commitear el valor real.
SWR_PASSWORD=

# ---- CCE Cluster ----
# Nombre del namespace de Kubernetes
KUBE_NAMESPACE=data-analyst-agent

# ---- ELB (Elastic Load Balancer) ----
# Type: public (con EIP) o internal (sin EIP)
ELB_TYPE=public

# Ancho de banda del EIP (Mbps)
ELB_BANDWIDTH_SIZE=5

# Tipo de EIP: 5_bgp (BGP) o 5_sbgp (SBGP)
ELB_EIP_TYPE=5_bgp

# ---- Modelo LLM ----
# analyst-smart / analyst-fast        -> MaaS Huawei (requiere MAAS_API_KEY)
# analyst-local / analyst-local-fast   -> Ollama (local, sin coste)
ANALYST_MODEL=analyst-local-fast

# ---- Secrets de la app (se cargan en 01-secrets.yaml) ----
LITELLM_MASTER_KEY=sk-local-secret

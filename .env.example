# API Key de Huawei Cloud MaaS (requerida para analyst-smart / analyst-fast)
# Dejar vacia si se usa Ollama local (analyst-local / analyst-local-fast)
MAAS_API_KEY=TU_MaaS_API_KEY

LITELLM_MASTER_KEY=sk-local-secret
LITELLM_BASE_URL=http://litellm:4000/v1

# DB y Redis propios de LiteLLM (tracking de spend, caching)
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm
LITELLM_REDIS_URL=redis://litellm-redis:6379/0

# DB y Redis de la aplicacion (agente)
AGENT_DATABASE_URL=postgresql://agent:agent@app-postgres:5432/agent
ANALYTICS_DATABASE_URL=postgresql://analyst_agent:analyst@app-analytics:5432/analytics

REDIS_URL=redis://app-redis:6379/0

# Alias de modelo expuesto por LiteLLM:
#   analyst-smart / analyst-fast        -> MaaS GLM-5.2 (requiere MAAS_API_KEY)
#   analyst-local / analyst-local-fast   -> Ollama (local, sin coste)
# Default recomendado para tests locales: analyst-local-fast (qwen2.5:1.5b)
ANALYST_MODEL=analyst-smart

# Solo para tests con modelo local (probe de readiness):
# OLLAMA_HOST=http://localhost:11434

# ---- Servidores MCP (consumidos por el agente) ----
# Si se omiten, el agente arranca en modo pipeline-only (sin tools MCP).
MCP_GLOSSARY_URL=http://mcp-glossary:8100/mcp
MCP_EXPLORER_URL=http://mcp-explorer:8101/mcp
# MCP_FILESYSTEM_URL=http://mcp-filesystem:8102/mcp
# MCP_WEBSEARCH_URL=http://mcp-websearch:8103/mcp

# ---- Agente como servidor MCP ----
# El endpoint /mcp expone la tool ask_analytics para clientes MCP
# como Claude Desktop. URL: http://<host>:8000/mcp

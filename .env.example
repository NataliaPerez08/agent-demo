OPENAI_API_KEY=TU_API_KEY

LITELLM_MASTER_KEY=sk-local-secret
LITELLM_BASE_URL=http://litellm:4000/v1

AGENT_DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
ANALYTICS_DATABASE_URL=postgresql://analyst_agent:analyst@analytics:5432/analytics

REDIS_URL=redis://redis:6379/0

# Alias de modelo expuesto por LiteLLM:
#   analyst-smart / analyst-fast        -> OpenAI (requiere OPENAI_API_KEY)
#   analyst-local / analyst-local-fast   -> Ollama (local, sin coste)
# Default recomendado para tests locales: analyst-local-fast (qwen2.5:1.5b)
ANALYST_MODEL=analyst-smart

# Solo para tests con modelo local (probe de readiness):
# OLLAMA_HOST=http://localhost:11434